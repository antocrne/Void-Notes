          "stringUnit" : {
            "state" : "translated",
            "value" : "Void Notes uses Face ID to show your locked notes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Void Notes utilise Face ID pour afficher vos notes verrouillées."
