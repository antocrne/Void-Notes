    "NSAudioCaptureUsageDescription" : {
      "comment" : "Privacy - Audio Capture Usage Description",
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Void Notes listens to the Mac's sound (a call, a video) to write what is said in the note. Transcription happens on the Mac."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Void Notes écoute le son du Mac (un appel, une vidéo) pour écrire dans la note ce qui est dit. La transcription se fait sur le Mac."
          }
        }
      }
    },
    "NSFaceIDUsageDescription" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
