<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Void Notes Beta: no voidnotes:// scheme, so that what Void sends always goes to Void Notes.
	     The other keys are generated by Xcode. -->
	<!-- The listening: the Mac's own sound (a call, a video), through a Core Audio process tap. -->
	<key>NSAudioCaptureUsageDescription</key>
	<string>Void Notes écoute le son du Mac (un appel, une vidéo) pour écrire dans la note ce qui est dit. La transcription se fait sur le Mac.</string>
	<!-- A note dragged in the list, on its way to a folder (see Info.plist). -->
	<key>UTExportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>app.void.notes.note</string>
			<key>UTTypeDescription</key>
			<string>Note de Void Notes</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
